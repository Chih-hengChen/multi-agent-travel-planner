{
  "name": "multi-agent-travel-planner",
  "version": "1.0.0",
  "description": "Multi-Agent Travel Planner - Node.js/TypeScript: 6 agents + pipeline + parallel + budget loop",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:api": "tsx src/api/app.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:api": "node dist/api/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^9.1.3",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
