<ul class="state-diff" id="rd"></ul>
<details class="fallback-summary">
<summary>Fallback distribution</summary>
<table><thead><tr><th>Tool</th><th>Calls</th><th>FB</th><th>Rate</th><th>By Level</th></tr></thead>
<tbody id="fbt"></tbody></table></details>
</aside>
</div>
<script>const D=[{"i":0,"t":"用户想规划东京旅行,但还没说日期和预算。先调 collect_preferences 触发偏好采集。","te":[{"n":"collect_preferences","d":800,"l":0,"ln":"no fallback defined","s":"{\\n  \\"requiresUserInput\\": true\\n}","w":0}],"sc":[{"f":"preferences","o":"set","v":"{\\n  \\"destination\\": \\"东京\\",\\n  \\"budget\\": 15000\\n}"}],"er":[]},{"i":1,"t":"phase=searching, 已有目的地东京+2人+¥15000预算。并行获取百科/景点/酒店/小红书。","te":[{"n":"search_baike","d":325,"l":0,"ln":"baike_api","s":"{\\n  \\"city\\": \\"东京\\",\\n  \\"len\\": 1850,\\n  \\"source\\": \\"web_search_baidu\\"\\n}","w":0},{"n":"search_attractions","d":1200,"l":0,"ln":"amap_poi","s":"{\\n  \\"itemCount\\": 12,\\n  \\"top\\": [\\n    \\"浅草寺\\",\\n    \\"明治神宫\\",\\n    \\"晴空塔\\",\\n    \\"银座\\"\\n  ]\\n}","w":0},{"n":"search_hotels","d":800,"l":0,"ln":"booking_api","s":"{\\n  \\"itemCount\\": 8,\\n  \\"top\\": [\\n    \\"Hotel Mystays 浅草\\",\\n    \\"APA 新宿\\",\\n    \\"Comfort 银座\\"\\n  ]\\n}","w":0},{"n":"search_xhs","d":3400,"l":0,"ln":"xhs_service","s":"{\\n  \\"total\\": 30,\\n  \\"top\\": [\\n    \\"东京小众打卡\\",\\n    \\"浅草寺避坑\\"\\n  ]\\n}","w":0}],"sc":[{"f":"baikeKnowledge","o":"set","v":"东京概况:关东平原南部..."},{"f":"candidateAttractions","o":"append","v":"+ 浅草寺, 明治神宫, 晴空塔, 银座, 涩谷, 秋叶原"}],"er":[]},{"i":2,"t":"已有景点和酒店候选。下一步找航班和城市级餐厅。","te":[{"n":"search_flights","d":1500,"l":0,"ln":"amadeus_api","s":"{\\n  \\"itemCount\\": 6,\\n  \\"top\\": [\\n    \\"CA183 北京-东京\\",\\n    \\"JL020\\"\\n  ]\\n}","w":0},{"n":"search_restaurants","d":1200,"l":0,"ln":"amap_poi","s":"{\\n  \\"scope\\": \\"city\\",\\n  \\"itemCount\\": 10,\\n  \\"top\\": [\\n    \\"浅草今半\\",\\n    \\"一兰拉面\\",\\n    \\"叙々苑\\"\\n  ]\\n}","w":0}],"sc":[{"f":"candidateTransports","o":"append","v":"+ 6 个航班选项"},{"f":"candidateRestaurants","o":"append","v":"+ 浅草今半, 一兰拉面, 叙々苑"}],"er":[]},{"i":3,"t":"候选已齐全。推荐 CA183 去程 + Hotel Mystays 浅草。","te":[{"n":"select_transport","d":300,"l":0,"ln":"no fallback defined","s":"{\\n  \\"outbound\\": {\\n    \\"flightNo\\": \\"CA183\\",\\n    \\"price\\": 2800\\n  }\\n}","w":0},{"n":"select_hotel","d":200,"l":0,"ln":"no fallback defined","s":"{\\n  \\"hotel\\": {\\n    \\"name\\": \\"Hotel Mystays 浅草\\",\\n    \\"pricePerNight\\": 900\\n  }\\n}","w":0}],"sc":[{"f":"selectedOutbound","o":"set","v":"CA183"},{"f":"selectedHotel","o":"set","v":"Hotel Mystays 浅草"}],"er":[]},{"i":4,"t":"进入 planning,编排 5 天行程。先查浅草寺→晴空塔交通。","te":[{"n":"plan_transit","d":1200,"l":0,"ln":"amap_direction","s":"{\\n  \\"from\\": \\"浅草寺\\",\\n  \\"to\\": \\"晴空塔\\",\\n  \\"mode\\": \\"walking\\",\\n  \\"durationMin\\": 15,\\n  \\"distanceKm\\": 1.2\\n}","w":0}],"sc":[{"f":"dayPlans[0].transits","o":"append","v":"浅草寺 → 晴空塔 walking 15min"}],"er":[]},{"i":5,"t":"5天行程编排完毕,预算¥14,200在¥15,000内。调用 finalize_plan 交付。","te":[{"n":"finalize_plan","d":1000,"l":0,"ln":"no fallback defined","s":"{\\n  \\"plan\\": \\"完成 5 天行程\\",\\n  \\"breakdown\\": {\\n    \\"totalCost\\": 14200,\\n    \\"budgetLimit\\": 15000,\\n    \\"isWithinBudget\\": true\\n  }\\n}","w":0}],"sc":[{"f":"dayPlans","o":"set","v":"5 天行程已编排"},{"f":"budgetBreakdown","o":"set","v":"¥14,200 / ¥15,000 (节省 ¥800)"}],"er":[]}],F=[{"tool":"collect_preferences","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}},{"tool":"finalize_plan","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}},{"tool":"plan_transit","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}},{"tool":"search_attractions","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}},{"tool":"search_baike","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}},{"tool":"search_flights","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}},{"tool":"search_hotels","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}},{"tool":"search_restaurants","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}},{"tool":"search_xhs","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}},{"tool":"select_hotel","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}},{"tool":"select_transport","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}}];
function S(n){document.querySelectorAll(".iter-item").forEach(e=>e.classList.toggle("selected",+e.dataset.iter===n));C(n);R(n)}
function C(n){var d=D[n];if(!d)return;document.getElementById("ct").textContent=d.t||"(no thought)";var el=document.getElementById("ctl"),t=el.parentElement.querySelector("h3");t.textContent="Tool calls ("+d.te.length+")";el.innerHTML=d.te.length?d.te.map(function(t){return'<li class="tool-call"><div class="tool-header"><span class="tool-name">'+t.n+'</span><span class="duration">'+t.d+'ms</span><span class="fallback-badge '+(t.l==0?"ok":t.l==1?"warn":"err")+'" title="L'+t.l+' = '+t.ln+'">L'+t.l+"●</span>"+(t.w?'<span class="amap-wait">+'+t.w+"ms</span>":"")+'</div><details class="result"><summary>Result</summary><pre>'+t.s.replace(/&/g,"&amp;").replace(/</g,"&lt;")+"</pre></details></li>"}).join(""):'<li class="empty-msg">no tool calls</li>';var ee=document.getElementById("ce");ee.hidden=!d.er.length;if(d.er.length)ee.querySelector("pre").textContent=d.er.join("\\n")}
function R(n){var d=D[n];if(!d)return;var el=document.getElementById("rd");el.innerHTML=d.sc.length?d.sc.map(function(s){return'<li class="op-'+s.o+'"><span class="field">'+s.f+'</span><span class="op">'+s.o+'</span><span class="value">'+s.v.replace(/&/g,"&amp;").replace(/</g,"&lt;")+"</span></li>"}).join(""):'<div class="empty-msg">no state changes</div>'}
document.addEventListener("DOMContentLoaded",function(){document.querySelectorAll(".iter-item").forEach(function(e){e.addEventListener("click",function(){S(+e.dataset.iter)})});document.getElementById("fbt").innerHTML=F.map(function(f){return'<tr><td>'+f.tool+'</td><td>'+f.total+'</td><td>'+f.fallbackCount+'</td><td class="'+(f.rate>0.3?"warn":f.rate==0?"ok":"")+'">'+(f.rate*100).toFixed(1)+'%</td><td>'+Object.entries(f.byLevel).map(function(e){return"L"+e[0]+":"+e[1]}).join(" ")+'</td></tr>'}).join("");S(0)})</script>
