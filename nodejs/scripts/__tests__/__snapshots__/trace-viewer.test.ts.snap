<div class="layout">
<aside class="left-pane"><div class="phase-group"><div class="phase-header">gathering (1)</div><ul><li class="iter-item" data-iter="0"><span class="iter-dot "></span>iter 0</li></ul></div><div class="phase-group"><div class="phase-header">planning (4)</div><ul><li class="iter-item" data-iter="1"><span class="iter-dot err"></span>iter 1</li><li class="iter-item" data-iter="2"><span class="iter-dot err"></span>iter 2</li><li class="iter-item" data-iter="3"><span class="iter-dot err"></span>iter 3</li><li class="iter-item" data-iter="4"><span class="iter-dot "></span>iter 4</li></ul></div><div class="phase-group"><div class="phase-header">completed (0)</div><ul></ul></div></aside>
<main class="center-pane">
<section class="thought"><h3>Thought</h3><blockquote id="ct"></blockquote></section>
<section class="tool-calls"><h3>Tool calls (0)</h3><ul id="ctl"></ul></section>
<section class="errors" id="ce" hidden><h3>Errors</h3><pre></pre></section>
</main>
<aside class="right-pane">
<h3>State diff</h3>
<ul class="state-diff" id="rd"></ul>
<details class="fallback-summary">
<summary>Fallback distribution</summary>
<table><thead><tr><th>Tool</th><th>Calls</th><th>FB</th><th>Rate</th><th>By Level</th></tr></thead>
<tbody id="fbt"></tbody></table></details>
</aside>
</div>
<script>const D=[{"i":0,"t":"","te":[],"sc":[],"er":[]},{"i":1,"t":"编排完成,输出JSON。","te":[],"sc":[],"er":["JSON parse failed: Unexpected token i at position 1"]},{"i":2,"t":"上次JSON有尾逗号,修复。","te":[],"sc":[],"er":["JSON parse failed: Unexpected token , at position 92"]},{"i":3,"t":"检查所有逗号和括号。","te":[],"sc":[],"er":["JSON parse failed: dayPlans[0] missing dining array"]},{"i":4,"t":"补全dining,确认schema全通过。","te":[{"n":"finalize_plan","d":1000,"l":0,"ln":"no fallback defined","s":"{\\n  \\"plan\\": \\"4th attempt succeeded\\",\\n  \\"breakdown\\": {\\n    \\"totalCost\\": 14200,\\n    \\"budgetLimit\\": 15000,\\n    \\"isWithinBudget\\": true\\n  }\\n}","w":0}],"sc":[{"f":"dayPlans","o":"set","v":"5天行程已编排"},{"f":"budgetBreakdown","o":"set","v":"¥14,200/¥15,000"}],"er":[]}],F=[{"tool":"finalize_plan","total":1,"fallbackCount":0,"rate":0,"byLevel":{"0":1}}];
function S(n){document.querySelectorAll(".iter-item").forEach(e=>e.classList.toggle("selected",+e.dataset.iter===n));C(n);R(n)}
function C(n){var d=D[n];if(!d)return;document.getElementById("ct").textContent=d.t||"(no thought)";var el=document.getElementById("ctl"),t=el.parentElement.querySelector("h3");t.textContent="Tool calls ("+d.te.length+")";el.innerHTML=d.te.length?d.te.map(function(t){return'<li class="tool-call"><div class="tool-header"><span class="tool-name">'+t.n+'</span><span class="duration">'+t.d+'ms</span><span class="fallback-badge '+(t.l==0?"ok":t.l==1?"warn":"err")+'" title="L'+t.l+' = '+t.ln+'">L'+t.l+"●</span>"+(t.w?'<span class="amap-wait">+'+t.w+"ms</span>":"")+'</div><details class="result"><summary>Result</summary><pre>'+t.s.replace(/&/g,"&amp;").replace(/</g,"&lt;")+"</pre></details></li>"}).join(""):'<li class="empty-msg">no tool calls</li>';var ee=document.getElementById("ce");ee.hidden=!d.er.length;if(d.er.length)ee.querySelector("pre").textContent=d.er.join("\\n")}
function R(n){var d=D[n];if(!d)return;var el=document.getElementById("rd");el.innerHTML=d.sc.length?d.sc.map(function(s){return'<li class="op-'+s.o+'"><span class="field">'+s.f+'</span><span class="op">'+s.o+'</span><span class="value">'+s.v.replace(/&/g,"&amp;").replace(/</g,"&lt;")+"</span></li>"}).join(""):'<div class="empty-msg">no state changes</div>'}
document.addEventListener("DOMContentLoaded",function(){document.querySelectorAll(".iter-item").forEach(function(e){e.addEventListener("click",function(){S(+e.dataset.iter)})});document.getElementById("fbt").innerHTML=F.map(function(f){return'<tr><td>'+f.tool+'</td><td>'+f.total+'</td><td>'+f.fallbackCount+'</td><td class="'+(f.rate>0.3?"warn":f.rate==0?"ok":"")+'">'+(f.rate*100).toFixed(1)+'%</td><td>'+Object.entries(f.byLevel).map(function(e){return"L"+e[0]+":"+e[1]}).join(" ")+'</td></tr>'}).join("");S(0)})</script>
