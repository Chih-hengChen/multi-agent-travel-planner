<body>
<header class="top-bar">
<div class="meta">
<span>Session: happy-path</span>
<span>Iters: 6</span>
<span>Duration: 45.4s</span>
<span>Tool calls: 11</span>
<span class="">Fallback rate: 0.0%</span>
<span class="">Errors: 0</span>
</div>
<div class="timeline">gathering(1) → searching(2) → selecting(1) → planning(2) → completed(1)</div></header>
<div class="layout">
<aside class="left-pane"><div class="phase-group"><div class="phase-header">gathering (1)</div><ul><li class="iter-item" data-iter="0"><span class="iter-dot "></span>iter 0</li></ul></div><div class="phase-group"><div class="phase-header">searching (2)</div><ul><li class="iter-item" data-iter="1"><span class="iter-dot "></span>iter 1</li><li class="iter-item" data-iter="2"><span class="iter-dot "></span>iter 2</li></ul></div><div class="phase-group"><div class="phase-header">selecting (1)</div><ul><li class="iter-item" data-iter="3"><span class="iter-dot "></span>iter 3</li></ul></div><div class="phase-group"><div class="phase-header">planning (2)</div><ul><li class="iter-item" data-iter="4"><span class="iter-dot "></span>iter 4</li><li class="iter-item" data-iter="5"><span class="iter-dot "></span>iter 5</li></ul></div><div class="phase-group"><div class="phase-header">completed (0)</div><ul></ul></div></aside>
<main class="center-pane">
<section class="thought"><h3>Thought</h3><blockquote id="ct"></blockquote></section>
<section class="tool-calls"><h3>Tool calls (0)</h3><ul id="ctl"></ul></section>
<section class="errors" id="ce" hidden><h3>Errors</h3><pre></pre></section>
</main>
<aside class="right-pane">
